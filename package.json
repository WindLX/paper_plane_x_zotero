{
  "name": "paper-plane-x-zotero",
  "type": "module",
  "version": "0.1.11",
  "description": "Zotero plugin for Paper Plane X",
  "config": {
    "addonName": "Paper Plane X",
    "addonID": "paperplanex@windlx",
    "addonRef": "paperplanex",
    "addonInstance": "PaperPlaneX",
    "prefsPrefix": "extensions.zotero.paperplanex"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WindLX/paper_plane_x.git",
    "directory": "paper_plane_x_zotero"
  },
  "author": "windlx",
  "bugs": {
    "url": "https://github.com/WindLX/paper_plane_x/issues"
  },
  "homepage": "https://github.com/WindLX/paper_plane_x/tree/main/paper_plane_x_zotero#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:manifest && zotero-plugin test",
    "test:manifest": "node test/manifestCompatibility.node.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "lucide": "^1.34.0",
    "marked": "^18.0.11",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.1",
    "eslint": "^10.9.1",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
